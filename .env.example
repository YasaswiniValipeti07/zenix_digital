# Digital Risk Protection - Supabase Configuration Example
# This file is SAFE to commit to version control.
# Copy to .env and replace with your actual Supabase keys.

# ============================================================
# Supabase Database Configuration
# ============================================================
# Get from: https://supabase.com → Settings → API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJyour-anon-key-here

# ============================================================
# Application Secret Key
# ============================================================
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_KEY=change-this-to-a-secure-random-value

# ============================================================
# Server Configuration
# ============================================================
PORT=3000
NODE_ENV=development